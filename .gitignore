out/
__pycache__/
*.pyc
.venv/
node_modules/
.pytest_cache/
*.yaml.bak

# derived caches: rebuilt from the vendor APIs on demand
vendor/catalog/

# session state, not source: a lock naming a PID belongs to one machine
.claude/scheduled_tasks.lock

# Exports land wherever the save dialog was last pointed, and that is often
# the repo root. They are generated from a scene, so they are never source.
# ...and the browser's "(2)" suffix when you export twice, which the exact
# names missed.
*-layers*.svg
*-layers*.dxf
*-render*.png
*-photo*.png
# ...and the sheet-split exports, whose names the patterns above miss
*-sheet-*.svg
*-sheet-*.dxf
*-cutlist.txt
export/
